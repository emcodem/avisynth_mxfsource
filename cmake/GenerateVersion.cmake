# Writes the build's version to OUT (a C header), run at build time by the
# mxfsrc_version target (see CMakeLists.txt) so every build carries the
# version of the commit it was built from, not of the last CMake configure.
#
#   -DSOURCE_DIR=<repo>  -DOUT=<header>  -DFALLBACK=<x.y.z>  [-DGIT=<git exe>]
#
# Version: `git describe --tags --always --dirty` without a leading "v"
# (a release tag gives "0.2.0" or "0.2.0-beta.1"; between tags
# "0.1.0-7-gef5b1af"; with uncommitted changes "-dirty" is appended).
# Without git or tags: FALLBACK. The file is only rewritten when the version
# changed, so an unchanged build doesn't recompile anything.

set(version "")
if(GIT)
  execute_process(
    COMMAND "${GIT}" describe --tags --always --dirty
    WORKING_DIRECTORY "${SOURCE_DIR}"
    OUTPUT_VARIABLE version
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET
    RESULT_VARIABLE result)
  if(NOT result EQUAL 0)
    set(version "")
  endif()
endif()
if(NOT version MATCHES "^v?[0-9]+\\.[0-9]+")
  # No tag reachable (or no git): describe only gave a hash, or nothing.
  if(version)
    set(version "${FALLBACK}-g${version}")
  else()
    set(version "${FALLBACK}")
  endif()
endif()
string(REGEX REPLACE "^v" "" version "${version}")
string(REGEX MATCH "^([0-9]+)\\.([0-9]+)" _ "${version}")
set(major "${CMAKE_MATCH_1}")
set(minor "${CMAKE_MATCH_2}")

set(content "// Generated by cmake/GenerateVersion.cmake -- do not edit.
#pragma once
#define MXFSRC_VERSION \"${version}\"
#define MXFSRC_VERSION_MAJOR ${major}
#define MXFSRC_VERSION_MINOR ${minor}
")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
else()
  set(old "")
endif()
if(NOT old STREQUAL content)
  file(WRITE "${OUT}" "${content}")
endif()
